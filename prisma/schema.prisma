generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Show {
  id          Int         @id @default(autoincrement())
  title       String
  description String?
  genre       String?
  status      WatchStatus @default(PLANNED)
  rating      Float?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

enum WatchStatus {
  PLANNED
  WATCHING
  COMPLETED
  DROPPED
}